# API Keys
# Get your free Groq API key from https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# Optional: OpenAI API Key if using OpenAI model provider
OPENAI_API_KEY=sk-your_openai_api_key_here

# LLM Configuration
# Options for Groq: llama-3.3-70b-versatile, mixtral-8x7b-32768, llama-3.1-8b-instant
LLM_PROVIDER=groq
MODEL_NAME=llama-3.3-70b-versatile
TEMPERATURE=0.2

# Vector Store & Embedding Configuration
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHROMA_PERSIST_DIR=./data/chroma_db

# Document Processing & Chunking Parameters
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K_RESULTS=4

# Logging & App Settings
LOG_LEVEL=INFO
